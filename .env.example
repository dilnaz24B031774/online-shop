# Copy this file to .env (next to manage.py) and write your own values.
# .env is NOT pushed to GitHub: every teammate has their own.

POSTGRES_DB=shopdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DEBUG=1
# SECRET_KEY=any-long-random-text

# Only for a quick run without PostgreSQL (tests, offline):
# USE_SQLITE=1

# Gmail SMTP for password recovery. Fill both values in .env only.
# Use a Google app password, not your normal Google account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional: defaults to EMAIL_HOST_USER when blank.
DEFAULT_FROM_EMAIL=
FRONTEND_URL=http://localhost:4200

# Telegram recovery bot created with @BotFather. Token stays in .env only.
TELEGRAM_BOT_TOKEN=
# Bot username without @, for example sauda_recovery_bot.
TELEGRAM_BOT_USERNAME=

# Delivery address on the courier map (OpenStreetMap Nominatim, free, no key).
# Put your shop name and a contact e-mail here, as Nominatim's usage policy asks.
# NOMINATIM_USER_AGENT=SaudaShop/1.0 (you@example.com)
# NOMINATIM_ENABLED=0   # turn address lookup off
