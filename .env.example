# Copy to .env if needed. .env is private and ignored by Git.
# PostgreSQL used by the local shop
POSTGRES_DB=onlineshop
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Gmail SMTP. Fill both values in .env only.
# Use a Google app password, not your normal Google account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional: defaults to EMAIL_HOST_USER when blank.
DEFAULT_FROM_EMAIL=
FRONTEND_URL=http://localhost:4200

# Telegram recovery bot created with @BotFather. Token stays in .env only.
TELEGRAM_BOT_TOKEN=
# Bot username without @, for example sauda_recovery_bot.
TELEGRAM_BOT_USERNAME=
